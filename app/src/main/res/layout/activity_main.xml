<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_principal"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/main_padding_horizontal"
        android:paddingEnd="@dimen/main_padding_horizontal"
        android:paddingTop="@dimen/main_padding_top"
        android:paddingBottom="@dimen/activity_margin">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/element_margin">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bienvenido"
                    android:textColor="@color/white"
                    android:textSize="@dimen/main_title_size"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subtitulo_principal"
                    android:textColor="@color/texto_secundario"
                    android:textSize="@dimen/main_subtitle_size"
                    android:layout_marginTop="@dimen/main_small_margin" />

            </LinearLayout>

        </LinearLayout>

        <!-- Decoración -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_divider_height"
            android:background="@color/color_decoracion"
            android:alpha="0.35"
            android:layout_marginTop="@dimen/main_divider_margin_top"
            android:layout_marginBottom="@dimen/main_divider_margin_bottom" />

        <!-- Promedio -->
        <Button
            android:id="@+id/btnEjercicioPromedio"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_button_height"
            android:text="@string/ejercicio_promedio"
            android:textColor="@color/white"
            android:textSize="@dimen/main_button_text_size"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/main_button_padding_start"
            android:paddingEnd="@dimen/main_button_padding_end"
            android:textAllCaps="false"
            android:background="@drawable/bg_tarjeta_principal"
            android:elevation="@dimen/main_button_elevation" />

        <!-- Salario -->
        <Button
            android:id="@+id/btnEjercicioSalario"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_button_height"
            android:layout_marginTop="@dimen/main_button_margin_top"
            android:text="@string/ejercicio_salario"
            android:textColor="@color/white"
            android:textSize="@dimen/main_button_text_size"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/main_button_padding_start"
            android:paddingEnd="@dimen/main_button_padding_end"
            android:textAllCaps="false"
            android:background="@drawable/bg_tarjeta_principal"
            android:elevation="@dimen/main_button_elevation" />

        <!-- Calculadora -->
        <Button
            android:id="@+id/btnEjercicioCalculadora"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_button_height"
            android:layout_marginTop="@dimen/main_button_margin_top"
            android:text="@string/ejercicio_calculadora"
            android:textColor="@color/white"
            android:textSize="@dimen/main_button_text_size"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/main_button_padding_start"
            android:paddingEnd="@dimen/main_button_padding_end"
            android:textAllCaps="false"
            android:background="@drawable/bg_tarjeta_principal"
            android:elevation="@dimen/main_button_elevation" />

        <!-- Espacio -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_space_height" />

        <!-- Historial -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_history_height"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/main_history_padding"
            android:paddingEnd="@dimen/main_history_padding"
            android:background="@drawable/bg_historial">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/historial_operaciones"
                android:textColor="@color/texto_secundario"
                android:textSize="@dimen/main_subtitle_size" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>